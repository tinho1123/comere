{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bilalbaraz/supabase-laravel": "^0.1.2",
        "filament/filament": "^3.3",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^10.48.29",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "minishlink/web-push": "^10.0",
        "stripe/stripe-php": "^10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.46",
        "lucascudo/laravel-pt-br-localization": "^3.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
"allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "GHSA-crmm-hgp2-wgrp": "PKSA-m5cs-t1y6-qpcs — Laravel Framework: Temporary Signed URL Path Confusion — sem patch na serie 10.x (so a partir do 12.61.1); projeto nao usa URL::temporarySignedRoute/signedRoute.",
                    "GHSA-5vg9-5847-vvmq": "PKSA-3r5d-mb8f-1qw9 — CRLF injection na regra 'email' — sem patch na serie 10.x (so a partir do 12.60.0); projeto nao envia e-mail (sem uso de Mail:: no codigo).",
                    "CVE-2026-48019": "PKSA-mdq4-51ck-6kdq — mesma CRLF injection acima, reportada por outra fonte de advisory (FriendsOfPHP) — mesma justificativa."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
